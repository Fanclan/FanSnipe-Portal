{
  "name": "streamsnipe-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:dashboard && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/copy-dashboard.mjs",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:dashboard && node scripts/artifact.mjs",
    "lint": "eslint dashboard/src tests *.config.ts"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fanclan/streamsnipe-protocol": "https://github.com/Fanclan/StreamSnipe-Companion/releases/download/protocol-v1.0.1/fanclan-streamsnipe-protocol-1.0.1.tgz",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "author": {
    "name": "The team at Fanclan.io",
    "url": "https://fanclan.io"
  },
  "maintainers": [
    "zerodayprime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fanclan/StreamSnipe-Portal.git"
  },
  "homepage": "https://streamsnipe-portal.vercel.app",
  "bugs": {
    "url": "https://github.com/Fanclan/StreamSnipe-Portal/issues"
  }
}
