---
import Base from '../layouts/Base.astro';
import { releases } from '../lib/releases';
---
<Base title="Downloads — StreamSnipe"><div class="wrap"><article class="prose"><div class="eyebrow">The companion / Downloads</div><h1>A studio for your device.</h1>{releases.length ? <><p class="lead">Verified releases of the StreamSnipe companion.</p>{releases.map(release=><section><h2>Version {release.version}</h2><p>Released {release.date}</p><ul>{release.artifacts.map(artifact=><li><a href={artifact.url}>{artifact.label} ↗</a><br/><small>SHA-256: <code>{artifact.sha256}</code></small></li>)}</ul></section>)}</> : <><p class="lead">The companion is being prepared for macOS, Windows and Docker. Verified release downloads will appear here when available.</p><h2>Release status</h2><p>No verified release assets are published yet. Visit the project repository for source and release updates.</p><p><a href="https://github.com/Fanclan/StreamSnipe-Companion">View the companion repository ↗</a></p></>}</article></div></Base>
