---
const {title='FanSnipe — Local Live Stream Recorder',description='Record live streams locally with FanSnipe. Monitor channels, save recordings and manage your own library without a cloud account.'}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const websiteId = new URL('/#website', Astro.site).href;
const organizationId = 'https://fanclan.io/#organization';
const graph = [
  {'@type':'Organization','@id':organizationId,name:'Fanclan.io',url:'https://fanclan.io'},
  {'@type':'WebSite','@id':websiteId,name:'FanSnipe',url:Astro.site?.href,publisher:{'@id':organizationId}},
  {'@type':'WebPage','@id':`${canonical.href}#webpage`,url:canonical.href,name:title,description,isPartOf:{'@id':websiteId}},
  ...(Astro.url.pathname === '/' ? [{'@type':'SoftwareApplication','@id':new URL('/#software',Astro.site).href,name:'FanSnipe',url:Astro.site?.href,applicationCategory:'MultimediaApplication',description,license:'https://opensource.org/license/mit',author:{'@id':organizationId},mainEntityOfPage:{'@id':`${canonical.href}#webpage`}}] : [])
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/>{import.meta.env.VERCEL_ENV && import.meta.env.VERCEL_ENV !== "production" && <meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={canonical}/><link rel="icon" href="/logo.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="en_US"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="FanSnipe by Fanclan.io"/><meta property="og:image" content={new URL("/social-preview.png", Astro.site)}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="FanSnipe: Your streams. Your storage. Built by Fanclan.io."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL("/social-preview.png", Astro.site)}/><meta name="twitter:image:alt" content="FanSnipe: Your streams. Your storage. Built by Fanclan.io."/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('ss-theme')||'dark'}catch{}</script><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})} /></head><body><header><a class="brand" href="/"><img src="/logo.svg" alt=""/> FanSnipe<span> / STUDIO</span></a><nav aria-label="Main navigation"><a href="/docs/">How it works</a><a href="/downloads/">Downloads</a><a href="/changelog/">Changelog</a><button id="theme" aria-label="Toggle light and dark theme">◐</button><a class="navcta" href="http://127.0.0.1:47821/app/">Open local studio</a></nav></header><main><slot/></main><footer><div><a class="brand" href="/"><img src="/logo.svg" alt=""/> FanSnipe</a><p>Made for the moments worth keeping.<br/>By the team at <a href="https://fanclan.io">Fanclan.io</a>.</p></div><div class="footerlinks"><a href="/app/">Hosted studio</a><a href="/docs/">Documentation</a><a href="/downloads/">Downloads</a><a href="/changelog/">Changelog</a><a href="/privacy/">Privacy</a><a href="https://github.com/Fanclan/FanSnipe-Portal">GitHub ↗</a><small>Maintained by zerodayprime · MIT licensed</small></div></footer><script is:inline>document.getElementById('theme').addEventListener('click',()=>{let t=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=t;localStorage.setItem('ss-theme',t)})</script></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#e9f3f2;background:#101617;--bg:#101617;--panel:#192122;--line:#303d3d;--muted:#9aabaa;--ink:#e9f3f2;--accent:#9cf1e8}*{box-sizing:border-box}html[data-theme=light]{--bg:#f1f5f2;--panel:#fff;--line:#cedbd7;--muted:#526864;--ink:#182b29;--accent:#087e75;color:var(--ink);background:var(--bg)}body{margin:0;background:var(--bg);color:var(--ink)}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}header{height:82px;display:flex;align-items:center;justify-content:space-between;max-width:1440px;margin:auto;padding:0 6%;border-bottom:1px solid var(--line)}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:750;letter-spacing:-.04em;font-size:21px}.brand img{width:35px}.brand span{font-size:9px;letter-spacing:.15em;color:var(--muted);margin-left:8px}nav{display:flex;gap:30px;align-items:center;font-size:13px;color:var(--muted)}button{font:inherit;cursor:pointer}#theme{border:0;background:none;color:var(--ink);font-size:22px}.navcta,.button{display:inline-block;background:var(--accent);color:#102927!important;padding:14px 20px;border-radius:7px;font-weight:700}.wrap{max-width:1320px;margin:auto;padding:0 6%}.eyebrow{color:var(--accent);font-size:11px;font-weight:750;letter-spacing:.16em;text-transform:uppercase}.hero{padding:100px 0 90px;display:grid;grid-template-columns:1fr 1fr;gap:7%;align-items:center}.hero h1{font-size:clamp(52px,6vw,88px);line-height:1.02;letter-spacing:-.065em;margin:24px 0}.hero p,.lead{font-size:18px;line-height:1.7;color:var(--muted);max-width:530px}.actions{display:flex;gap:22px;align-items:center;margin:32px 0}.textlink{font-weight:650;font-size:14px}.caption{font-size:12px;color:var(--muted)}.mock{border:1px solid #465555;background:#1b2526;padding:16px;border-radius:12px;box-shadow:0 35px 80px #0006;transform:rotate(1deg);color:#e9f3f2}.mocktop{display:flex;justify-content:space-between;color:#a9b9b7;font-size:10px;letter-spacing:.1em;padding:8px}.screen{margin-top:14px;border-radius:6px;height:260px;background:linear-gradient(135deg,#315958,#152425 60%,#576d64);display:grid;place-items:center}.play{border:1px solid #c1f9f1;border-radius:50%;width:58px;height:58px;display:grid;place-items:center;color:#bcfff7}.wave{display:flex;align-items:center;gap:3px;height:50px}.wave i{display:block;width:3px;background:#85d8d0;border-radius:5px}.mockrow{display:flex;align-items:center;justify-content:space-between;padding:14px 8px 0;font-size:11px;color:#a9b9b7}.section{padding:90px 0;border-top:1px solid var(--line)}.section h2{font-size:clamp(36px,4vw,55px);letter-spacing:-.055em;line-height:1.08;max-width:700px;margin:15px 0 45px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature{border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:28px;min-height:200px}.feature b{color:var(--accent);font-size:12px}.feature h3{font-size:20px;margin:35px 0 10px}.feature p,.prose p,.prose li{color:var(--muted);line-height:1.75;font-size:15px}.band{display:flex;justify-content:space-between;align-items:end;gap:30px}.band h2{margin-bottom:0}.prose{max-width:800px;padding:90px 0 120px;min-height:60vh}.prose h1{font-size:clamp(44px,6vw,68px);letter-spacing:-.06em;margin:15px 0 28px}.prose h2{margin-top:48px;font-size:25px}.prose a{color:var(--accent);text-decoration:underline}footer{border-top:1px solid var(--line);padding:55px 6%;display:flex;justify-content:space-between;color:var(--muted);font-size:13px;line-height:1.8}footer .brand{color:var(--ink)}.footerlinks{display:flex;gap:22px;align-items:start;flex-wrap:wrap}.footerlinks small{width:100%;text-align:right}@media(max-width:800px){header{height:auto;min-height:74px;align-items:start;padding-top:20px;padding-bottom:20px;gap:20px}nav{justify-content:flex-end;gap:13px;flex-wrap:wrap;font-size:12px}.brand span{display:none}.hero{grid-template-columns:1fr;padding:65px 0;gap:40px}.features{grid-template-columns:1fr}.section{padding:65px 0}.band,footer{display:block}.footerlinks{margin-top:30px}.footerlinks small{text-align:left}.mock{transform:none}}
</style>
<style is:global>
.hero>*{min-width:0}.mock{max-width:100%}.actions{flex-wrap:wrap}@media(max-width:800px){.hero h1{font-size:clamp(42px,11vw,64px);overflow-wrap:anywhere}.hero p{font-size:16px}.mock{width:100%}header .brand{flex-shrink:0}nav{min-width:0}}
</style>
